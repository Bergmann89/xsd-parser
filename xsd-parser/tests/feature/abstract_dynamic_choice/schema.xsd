<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:example" targetNamespace="urn:example"
    elementFormDefault="qualified">
    <xs:complexType name="Payload" abstract="true">
        <xs:attribute name="id" type="xs:unsignedInt" use="required"/>
    </xs:complexType>
    <xs:complexType name="Middle" abstract="true">
        <xs:complexContent><xs:extension base="tns:Payload"/></xs:complexContent>
    </xs:complexType>
    <xs:complexType name="Leaf">
        <xs:complexContent><xs:extension base="tns:Middle">
            <xs:attribute name="label" type="xs:string" use="required"/>
        </xs:extension></xs:complexContent>
    </xs:complexType>
    <xs:complexType name="Empty" abstract="true"/>
    <xs:element name="Head" type="xs:string" abstract="true"/>
    <xs:element name="AbstractMember" type="xs:string" abstract="true" substitutionGroup="tns:Head"/>
    <xs:element name="Member" type="xs:string" substitutionGroup="tns:AbstractMember"/>
    <xs:element name="EmptyHead" type="xs:string" abstract="true"/>
    <xs:element name="EmptyAbstractMember" type="xs:string" abstract="true" substitutionGroup="tns:EmptyHead"/>
    <xs:element name="Message"><xs:complexType><xs:sequence>
        <xs:element name="Payload" type="tns:Payload"/>
        <xs:element ref="tns:Head"/>
    </xs:sequence></xs:complexType></xs:element>
</xs:schema>
