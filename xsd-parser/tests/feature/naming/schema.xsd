<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com"
           targetNamespace="http://example.com"
           elementFormDefault="qualified">
    <xs:element name="Root" type="tns:RootType" />
    <xs:complexType name="RootType">
        <xs:sequence>
            <xs:element name="UserIDs" type="xs:string" />
            <xs:element name="MP3s" type="xs:string" />
            <xs:element name="IPv4s" type="xs:string" />
            <xs:element name="X509SKI" type="xs:string" />
            <xs:element name="Chord" type="tns:ChordType" />
        </xs:sequence>
        <xs:attribute name="aU" type="xs:int" />
    </xs:complexType>
    <xs:simpleType name="ChordType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dominant-11th" />
            <xs:enumeration value="1.2" />
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
