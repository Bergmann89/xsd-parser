<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="urn:imports" targetNamespace="urn:imports">
    <xs:simpleType name="Limit">
        <xs:union memberTypes="xs:unsignedInt">
            <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="unbounded"/>
            </xs:restriction></xs:simpleType>
        </xs:union>
    </xs:simpleType>
    <xs:simpleType name="Choice"><xs:union memberTypes="xs:int xs:string"/></xs:simpleType>
    <xs:simpleType name="Label"><xs:restriction base="xs:string">
        <xs:minLength value="1"/>
    </xs:restriction></xs:simpleType>
    <xs:simpleType name="Words"><xs:list itemType="xs:string"/></xs:simpleType>
    <xs:simpleType name="Mode"><xs:restriction base="xs:string">
        <xs:enumeration value="on"/><xs:enumeration value="off"/>
    </xs:restriction></xs:simpleType>
    <xs:element name="Root"><xs:complexType>
        <xs:attribute name="limit" type="tns:Limit" use="required"/>
        <xs:attribute name="choice" type="tns:Choice" use="required"/>
        <xs:attribute name="label" type="tns:Label" use="required"/>
        <xs:attribute name="words" type="tns:Words" use="required"/>
        <xs:attribute name="mode" type="tns:Mode" use="required"/>
    </xs:complexType></xs:element>
</xs:schema>
