<tns:Reference xmlns:tns="http://example.com" xmlns:other="http://example.com/other">
    <tns:Transforms>
        <tns:Transform Algorithm="http://www.w3.org/2002/06/xmldsig-filter2">
            <other:XPath Filter="intersect">
